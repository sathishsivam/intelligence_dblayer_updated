      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "from_account": {
                "type": "integer",
                "title": "From Account"
              },
              "to_account": {
                "type": "integer",
                "title": "To Account"
              },
              "amount": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0.0
                  },
                  {
                    "type": "string",
